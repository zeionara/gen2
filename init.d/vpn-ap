name="vpn-ap daemon"
description="Mihomo VPN service for AP routing"

command="/usr/bin/mihomo"
command_args="${vpn_ap_args}"
command_background="yes"

pidfile="/run/${RC_SVCNAME}.pid"
logfile="/var/log/mihomo.log"

start_stop_daemon_args="
    --stdout $logfile
    --stderr $logfile
"

depend() {
	need net
	after wpa_supplicant
}
